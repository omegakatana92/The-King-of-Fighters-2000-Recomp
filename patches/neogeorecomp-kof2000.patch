diff --git a/src/neogeo.c b/src/neogeo.c
index 3d16236..3826f94 100644
--- a/src/neogeo.c
+++ b/src/neogeo.c
@@ -158,12 +158,38 @@ static void script_input(long frame, ng_input_t *in) {
 
 /* ---- frame loop ---- */
 
+/* The MVS watchdog resets the board 3,244,030 master clocks (24 MHz) after
+ * the last kick, i.e. 1,622,015 68000 clocks.  Several games use it as a
+ * protection check: if a "sit in a loop" reset does not happen, they write
+ * a failure flag to backup RAM.  Kicks arrive as writes to $300001. */
+#define NG_WATCHDOG_CLOCKS 1622015
+
+static int64_t s_watchdog_deadline;
+
+void ng_watchdog_kick(void) { s_watchdog_deadline = ng_cycles + NG_WATCHDOG_CLOCKS; }
+
+static void watchdog_reset(void) {
+    /* A board reset: the 68k restarts from the BIOS vectors, the video and
+     * audio chips re-initialise, but work and backup RAM keep their data. */
+    ng_irq_pending = 4;
+    bus_reset();
+    lspc_reset();
+    pal_select_bank(0);
+    video_set_fix_bios(1);
+    audio_select_bios_rom(1);
+    audio_reset();
+    exec_reset();
+    ng_watchdog_kick();
+}
+
 static void run_until(int64_t t) {
     while (ng_cycles < t) {
         int64_t target = t, d = lspc_timer_deadline();
         if (d < target) target = d;
+        if (s_watchdog_deadline < target) target = s_watchdog_deadline;
         if (target > ng_cycles) exec_run(target);
         if (ng_cycles >= lspc_timer_deadline()) lspc_timer_fire();
+        if (ng_cycles >= s_watchdog_deadline) watchdog_reset();
     }
 }
 
